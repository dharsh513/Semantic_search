# Copy this file to `.env` and edit as needed. Every value is optional —
# the app runs with no .env file at all.

# ---------- Flask ----------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Flask's auto-reloader watches every imported module. sentence-transformers
# imports hundreds of `transformers` submodules lazily — AFTER the server is
# already running — and the reloader reads those as "files changed" and
# restarts mid-request, which shows up as "engine: offline" and failed
# searches. Leave this off unless you are editing the code, in which case the
# installed-package exclusions in app.py keep it usable.
USE_RELOADER=false

# Load the embedding model at startup rather than during the first search.
PRELOAD_EMBEDDER=true

# ---------- NCBI E-utilities ----------
# NO API KEY IS REQUIRED. PubMed allows 3 requests/second anonymously.
# Supplying a free key (https://ncbiinsights.ncbi.nlm.nih.gov/) raises it to 10/s.
# NCBI_API_KEY=
# NCBI_EMAIL=you@example.com
NCBI_RATE_LIMIT=2.5
CANDIDATE_POOL=60
ENABLE_ESPELL=true

# ---------- Embeddings ----------
# Downloaded once (~90 MB) from Hugging Face, then cached and run locally.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Larger/stronger alternatives:
#   sentence-transformers/all-mpnet-base-v2       (768-d, better, slower)
#   pritamdeka/S-PubMedBert-MS-MARCO              (biomedical-domain)
ALLOW_TFIDF_FALLBACK=true

# ---------- Retrieval ----------
TOP_K=10
TOP_K_CHUNKS=24
DENSE_WEIGHT=0.72
LEXICAL_WEIGHT=0.28
MMR_LAMBDA=0.72

# ---------- Optional LLM phrasing ----------
# Entirely optional. Without a key the answer is built extractively from the
# retrieved abstracts, which is fully grounded and costs nothing.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
